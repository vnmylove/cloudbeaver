<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>
    <extension point="org.jkiss.dbeaver.auth.provider">
        <authProvider id="teleport" label="%teleport.label" description="%teleport.description"
                      caseInsensitive="true"
                      trusted="true"
                      configurable="true"
                      sameTabRedirectOnLogout="true"
                      class="io.cloudbeaver.service.teleport.auth.TeleportJwtAuthProvider"
                      icon="platform:/plugin/org.jkiss.dbeaver.model/icons/tree/key.svg">
            <credentials>
                <propertyGroup label="General">
                    <property id="user" label="%user" type="string" description="%user.description"
                              admin="true" user="true" identifying="true"/>
                    <property id="fullName" label="%fullName" type="string" description="%fullName.description"/>
                    <!-- Non-identifying so the verified role list survives credential filtering and reaches team mapping. -->
                    <property id="teams" label="%teams" type="string" description="%teams.description"/>
                </propertyGroup>
            </credentials>
            <configuration>
                <propertyGroup label="Teleport">
                    <property id="jwks-url" label="%jwks-url" type="string" description="%jwks-url.description" required="true"/>
                    <property id="issuer" label="%issuer" type="string" description="%issuer.description" required="true"/>
                    <property id="audience" label="%audience" type="string" description="%audience.description" required="true"/>
                    <property id="header-name" label="%header-name" type="string" description="%header-name.description"
                              defaultValue="Teleport-Jwt-Assertion"/>
                    <property id="username-claim" label="%username-claim" type="string" description="%username-claim.description"
                              defaultValue="username"/>
                    <property id="display-name-claim" label="%display-name-claim" type="string" description="%display-name-claim.description"
                              defaultValue="username"/>
                    <property id="teams-claim" label="%teams-claim" type="string" description="%teams-claim.description"
                              defaultValue="roles"/>
                    <property id="team-filter-prefix" label="%team-filter-prefix" type="string" description="%team-filter-prefix.description"/>
                    <property id="team-strip-prefix" label="%team-strip-prefix" type="string" description="%team-strip-prefix.description"/>
                    <property id="auth-role-claim" label="%auth-role-claim" type="string" description="%auth-role-claim.description"/>
                    <property id="auto-user-provisioning" label="%auto-user-provisioning" type="boolean"
                              description="%auto-user-provisioning.description" defaultValue="true"/>
                    <property id="clock-skew-seconds" label="%clock-skew-seconds" type="integer"
                              description="%clock-skew-seconds.description" defaultValue="60"/>
                    <property id="jwks-cache-ttl-seconds" label="%jwks-cache-ttl-seconds" type="integer"
                              description="%jwks-cache-ttl-seconds.description" defaultValue="3600"/>
                    <property id="logout-url" label="%logout-url" type="string" description="%logout-url.description"/>
                </propertyGroup>
            </configuration>
            <metaParameters type="team">
                <propertyGroup label="Teleport role mapping">
                    <property id="teleport.role-name" label="%teleport.role-name" type="string"
                              description="%teleport.role-name.description"/>
                </propertyGroup>
            </metaParameters>
        </authProvider>
    </extension>

    <extension point="io.cloudbeaver.handler">
        <servletHandler id="TeleportLogoutServletHandler"
                        class="io.cloudbeaver.service.teleport.auth.TeleportLogoutServletHandler"/>
        <sessionHandler id="TeleportSessionHandler"
                        class="io.cloudbeaver.service.teleport.auth.TeleportSessionHandler"/>
    </extension>
</plugin>
